// FSR 1 sharpening pass (RCAS), AMD FidelityFX Super Resolution 1 (MIT,
// third_party/LICENSE-FSR.txt). Swaps red and blue for a BGRA window
// (kSwapRB): the result is copied into the window's image as it is.
#version 450
#extension GL_GOOGLE_include_directive : require
layout(constant_id = 0) const bool kSwapRB = false;
layout(push_constant) uniform Const { uvec4 c0; } pc;
layout(set = 0, binding = 0) uniform sampler2D in_tex;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D out_img;
#define A_GPU 1
#define A_GLSL 1
#include "third_party/ffx_a.h"
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(in_tex, p, 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "third_party/ffx_fsr1.h"
layout(local_size_x = 64) in;
void one(AU2 pos) {
  AF3 c;
  FsrRcasF(c.r, c.g, c.b, pos, pc.c0);
  imageStore(out_img, ASU2(pos), kSwapRB ? AF4(c.b, c.g, c.r, 1) : AF4(c, 1));
}
void main() {
  AU2 p = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
  one(p); p.x += 8u; one(p); p.y += 8u; one(p); p.x -= 8u; one(p);
}
