com/roblox/universalapp/messagebus/MessageBus.doSubscribeProtocolMethodRequestRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "Account" "magicLogin" new:acctMagicLogin false
com/roblox/universalapp/messagebus/MessageBus.doSubscribeProtocolMethodRequestRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "WebView" "isAvailable" new:webviewAvail false
com/roblox/universalapp/messagebus/MessageBus.doSubscribeProtocolMethodRequestRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "WebView" "openWindow" new:webviewOpen false
com/roblox/universalapp/messagebus/MessageBus.doSubscribeProtocolMethodRequestRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "MediaPicker" "isAvailable" new:mediaAvail false
com/roblox/universalapp/messagebus/MessageBus.doSubscribeProtocolMethodRequestRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "Linking" "isURLRegistered" new:linkIsURLReg false
com/roblox/universalapp/messagebus/MessageBus.doSubscribeProtocolMethodRequestRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "Linking" "isTrackingAvailable" new:linkTracking false
com/roblox/universalapp/messagebus/MessageBus.doSubscribeProtocolMethodRequestRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "SystemTheme" "systemThemeSetTheme" new:themeSet false

# Answers. Credentials (passkeys / saved passwords via Google Play services):
# none on this machine. Same shape as bm/r.i builds on Android, all false.
on credAvail com/roblox/universalapp/messagebus/MessageBus.publishRaw(Ljava/lang/String;Ljava/lang/String;)V "Credentials.isAvailableResponse" "{\"FIDO2\":{\"isAvailable\":false,\"supportsDeviceBoundOnly\":false,\"supportsSilentPasskeyUpgrade\":false,\"supportsPasskeyCreationOnDevice\":false},\"password\":{\"isAvailable\":false},\"keystore\":{\"isAvailable\":false}}"


# --- Request handlers the Android app registers (decompiled Java: yl/c,
# km/e, om/k). Synchronous ones answer through --values (RequestHandlerRaw#LABEL),
# asynchronous ones through "on" rules calling callResponseHandlerRaw.
com/roblox/universalapp/messagebus/MessageBus.setRequestHandlerRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RequestHandlerRaw;)V "ConnectivityProtocol" "GetNetworkStatus" new:connStatus
com/roblox/universalapp/messagebus/MessageBus.setRequestHandlerRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RequestHandlerRaw;)V "ConnectivityProtocol" "IsNetworkStatusAvailable" new:connAvail
com/roblox/universalapp/messagebus/MessageBus.setRequestHandlerRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RequestHandlerRaw;)V "Linking" "supportsSwitchToSettingsApp" new:linkSettingsSupported
com/roblox/universalapp/messagebus/MessageBus.setRequestHandlerRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RequestHandlerRaw;)V "Linking" "switchToSettingsApp" new:linkSettingsSwitch
com/roblox/universalapp/messagebus/MessageBus.setRequestHandlerAsyncRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RequestHandlerAsyncRaw;)V "PermissionsProtocol" "HasPermissions" new:permHas
com/roblox/universalapp/messagebus/MessageBus.setRequestHandlerAsyncRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RequestHandlerAsyncRaw;)V "PermissionsProtocol" "PermissionsRequest" new:permRequest
com/roblox/universalapp/messagebus/MessageBus.setRequestHandlerAsyncRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RequestHandlerAsyncRaw;)V "PermissionsProtocol" "SupportsPermissions" new:permSupports
com/roblox/universalapp/messagebus/MessageBus.setRequestHandlerAsyncRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RequestHandlerAsyncRaw;)V "PermissionsProtocol" "ShouldShowPermissionUpsell" new:permUpsell
com/roblox/universalapp/messagebus/MessageBus.setRequestHandlerAsyncRaw(Ljava/lang/String;Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RequestHandlerAsyncRaw;)V "PermissionsProtocol" "ShouldShowRequestPermissionRationale" new:permRationale
# Answers: no camera/mic/contacts/notification permissions on this machine.
on permHas com/roblox/universalapp/messagebus/MessageBus.callResponseHandlerRaw(Ljava/lang/String;Ljava/lang/String;)V "$arg2" "{\"status\":\"DENIED\",\"missingPermissions\":[]}"
on permRequest com/roblox/universalapp/messagebus/MessageBus.callResponseHandlerRaw(Ljava/lang/String;Ljava/lang/String;)V "$arg2" "{\"status\":\"DENIED\",\"missingPermissions\":[]}"
on permSupports com/roblox/universalapp/messagebus/MessageBus.callResponseHandlerRaw(Ljava/lang/String;Ljava/lang/String;)V "$arg2" "{\"permissions\":[]}"
on permUpsell com/roblox/universalapp/messagebus/MessageBus.callResponseHandlerRaw(Ljava/lang/String;Ljava/lang/String;)V "$arg2" "{\"upsellStatus\":\"HIDE\"}"
on permRationale com/roblox/universalapp/messagebus/MessageBus.callResponseHandlerRaw(Ljava/lang/String;Ljava/lang/String;)V "$arg2" "{\"upsellStatus\":\"HIDE\"}"

# ACTION_LOG_IN needs no answer: on this build's startup path (MainGameActivity)
# the Java side ignores it (ak/k0 falls back to an empty listener). The Lua
# app shows its own LoginNative page by itself.

# The WebView protocol (src/webview.cpp), set up where Android's Java side
# does it: while the activity is created, before the app starts (ak/a0 is made
# in NativeHelper.n0). Set up after StartApp, the engine's WebViewService never
# hears the page's callbacks and every challenge times out after 60 s.
# EnableWebViewService and EnableAndroidWebViewService (bytes the library
# keeps; 1 = on). Read only.
tonic webview
static com/roblox/engine/jni/NativeGLInterface.nativeAppBridgeV2StartAppWithParams(Lcom/roblox/engine/jni/autovalue/StartAppParams;)V new
