# --- MainGameActivity$Companion -------------------------------------------
# On Android this path holds content unpacked from the APK; an empty folder
# makes setAssetFolder throw. tonic unpacks it when the APK is installed.
static com/roblox/client/startup/MainGameActivity.nativeSetAssetPath(Ljava/lang/String;)V "${ASSETS}/content"
# Preload overrides (flat {"FFlag": "value"}), from scripts/settings-overrides.json.
# Only overrides survive the library's refetch ~2 minutes in.
static com/roblox/client/startup/MainGameActivity.nativePreloadFlagOverrides(Ljava/lang/String;)V file:data/settings/preload-overrides.json

# --- GameActivity.onCreate: starts android_main on its own thread. Next step.
# com/google/androidgamesdk/GameActivity.initializeNativeCode(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Landroid/content/res/AssetManager;[BLandroid/content/res/Configuration;)J "${DATA}/files" "${DATA}/obb" "${DATA}/external" new null new

# --- wh/e.E (ASMA.setup), after update_native_settings ----------------------
static com/roblox/engine/jni/NativeGLInterface.nativeGameGlobalInit()V
static com/roblox/engine/jni/NativeGLInterface.nativeUpdateAdapterInit()V

# Client settings: fetched at each start (src/clientsettings.cpp) and merged
# with scripts/settings-overrides.json. Needed for the Lua login screens and
# for captchas (EnableWebViewService, EnableAndroidWebViewService).
static com/roblox/engine/jni/NativeGLInterface.nativeInitClientSettings(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)I file:data/settings/client-settings.json "" "GoogleAndroidApp" => 0
static com/roblox/engine/jni/NativeGLInterface.nativePostClientSettingsLoadedInitialization3(Ljava/util/List;)V new
static com/roblox/engine/jni/NativeSettingsInterface.nativeIsLuaLoginEnabled()Z

# --- wh/e.j: app bridge init; InitParams values come from scripts/roblox.values
# Saved cookies back into the library, and a handler for new ones, as Java
# does at startup (sg/y0.S0, CookieProtocol): keeps you logged in between
# runs (src/cookies.hpp; data/files/tonic-cookies.txt, delete it to log out).
tonic cookies
static com/roblox/engine/jni/NativeGLInterface.nativeAppBridgeV2InitWithParams(Lcom/roblox/engine/jni/autovalue/InitParams;)V new

# --- start the app on the window (StartAppParams from scripts/roblox.values) ---
# --- message bus: each subscription gets a named callback; "on" rules answer as Java would.

# Plain messages: MessageBus.doSubscribeRaw(name, callback, flag)
com/roblox/universalapp/messagebus/MessageBus.doSubscribeRaw(Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "Credentials.isAvailableRequest" new:credAvail false
com/roblox/universalapp/messagebus/MessageBus.doSubscribeRaw(Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "Credentials.getCredentialsRequest" new:credGet false
com/roblox/universalapp/messagebus/MessageBus.doSubscribeRaw(Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "Credentials.registerCredentialsRequest" new:credRegister false
com/roblox/universalapp/messagebus/MessageBus.doSubscribeRaw(Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "Credentials.deleteKeystoreCredentialsRequest" new:credDelete false
com/roblox/universalapp/messagebus/MessageBus.doSubscribeRaw(Ljava/lang/String;Lcom/roblox/universalapp/messagebus/RawCallback;Z)Lcom/roblox/universalapp/messagebus/Connection; "Linking.isURLRegisteredRequest" new:linkURLReg false

